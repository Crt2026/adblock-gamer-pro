<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A00E68A" />
        </shape>
    </item>
    <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
        <shape android:shape="oval">
            <solid android:color="#0C2625" />
            <stroke android:width="1.5dp" android:color="#4000E5FF" />
        </shape>
    </item>
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <gradient android:startColor="#104437" android:endColor="#091A2B" android:angle="135" />
            <stroke android:width="3.5dp" android:color="#00E68A" />
        </shape>
    </item>
    <item android:top="16dp" android:bottom="16dp" android:left="16dp" android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#2E00E68A" />
        </shape>
    </item>
</layer-list>
