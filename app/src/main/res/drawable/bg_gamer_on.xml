<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1400E68A" />
        </shape>
    </item>
    <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
        <shape android:shape="oval">
            <solid android:color="#0C2621" />
            <stroke android:width="1dp" android:color="#2600E68A" />
        </shape>
    </item>
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <gradient android:startColor="#0E382D" android:endColor="#0A1B2B" android:angle="135" />
            <stroke android:width="3dp" android:color="#00E68A" />
        </shape>
    </item>
</layer-list>
