<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#14FF4D6D" />
        </shape>
    </item>
    <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
        <shape android:shape="oval">
            <solid android:color="#161425" />
            <stroke android:width="1dp" android:color="#2E5C2032" />
        </shape>
    </item>
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <gradient android:startColor="#211424" android:endColor="#101829" android:angle="135" />
            <stroke android:width="2.5dp" android:color="#FF4D6D" />
        </shape>
    </item>
</layer-list>
