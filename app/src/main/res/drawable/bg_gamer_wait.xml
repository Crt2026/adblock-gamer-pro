<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#18FFC247" />
        </shape>
    </item>
    <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
        <shape android:shape="oval">
            <solid android:color="#221B11" />
            <stroke android:width="1.5dp" android:color="#3DFF9F1C" />
        </shape>
    </item>
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <gradient android:startColor="#291F11" android:endColor="#0F1727" android:angle="135" />
            <stroke android:width="3dp" android:color="#FFC247" />
        </shape>
    </item>
    <item android:top="16dp" android:bottom="16dp" android:left="16dp" android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#2EFFC247" />
        </shape>
    </item>
</layer-list>
